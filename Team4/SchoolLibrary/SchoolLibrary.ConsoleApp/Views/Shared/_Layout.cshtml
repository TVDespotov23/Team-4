<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Училищна библиотека</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            margin: 0;
            padding: 0;
            color: #333;
        }
        .header {
            background-color: #2c3e50;
            color: white;
            padding: 20px;
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .container {
            max-width: 850px;
            margin: 40px auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }
        .msg {
            background: #e8f4fd;
            border-left: 4px solid #3498db;
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 4px;
            color: #084298;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        th, td {
            padding: 12px 15px;
            border-bottom: 1px solid #e2e8f0;
            text-align: left;
        }
        th {
            background-color: #f8f9fa;
            color: #495057;
            font-weight: bold;
        }
        tr:hover {
            background-color: #f8fafc;
        }
        .free {
            color: #27ae60;
            font-weight: bold;
            background-color: #e8f8f0;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 12px;
        }
        .taken {
            color: #c0392b;
            font-weight: bold;
            background-color: #fde8e8;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 12px;
        }
        button {
            padding: 6px 14px;
            cursor: pointer;
            border: none;
            border-radius: 4px;
            font-weight: bold;
            color: white;
        }
        form[action*="Borrow"] button {
            background-color: #3498db;
        }
        form[action*="Borrow"] button:hover {
            background-color: #2980b9;
        }
        form[action*="Return"] button {
            background-color: #e67e22;
        }
        form[action*="Return"] button:hover {
            background-color: #d35400;
        }
    </style>
</head>
<body>

<div class="header">
    📚 Училищна библиотека
</div>

<div class="container">
    @RenderBody()
</div>

</body>
</html>